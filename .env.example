# Copy to .env.local and fill in real values. Never commit .env.local.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GROQ_API_KEY=

# Optional, gates api/check-dead-links.ts. Vercel sets this automatically as
# a Bearer header when the cron in vercel.json invokes it; set the same
# value as a Vercel env var so the check passes.
CRON_SECRET=

# Optional, error monitoring no-ops entirely if this is unset
VITE_SENTRY_DSN=
